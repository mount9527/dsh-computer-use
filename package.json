{
  "name": "dsh-computer-use",
  "version": "0.4.0",
  "description": "让 DSH 在这台 Windows 电脑上做可验证的操作：观察 → 计划 → 执行 → 验证 → 留痕。默认不接管鼠标键盘，L3 高危动作走原生模态确认，Esc/页面按钮随时急停。",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "李峰",
    "url": "https://github.com/mount9527"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mount9527/dsh-computer-use.git"
  },
  "homepage": "https://github.com/mount9527/dsh-computer-use#readme",
  "bugs": {
    "url": "https://github.com/mount9527/dsh-computer-use/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "desktop-automation",
    "ui-automation",
    "windows",
    "ocr",
    "cdp",
    "non-intrusive"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "win32"
  ],
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/*.mjs",
    "scripts/desk.ps1",
    "scripts/selftest-target.ps1",
    "scripts/browser-selftest.html",
    "scripts/stop-watch.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
